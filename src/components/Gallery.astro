---
import SectionHeading from './SectionHeading.astro';
import { gallery } from '../data/site';
---

<section class="gallery section" id="galeria">
  <div class="shell">
    <SectionHeading
      eyebrow="Galería"
      title="Ideas que cobran vida cuando se comparten."
      copy="Una mirada a los encuentros, conferencias y conversaciones que forman parte de este camino empresarial."
      light
    />

    <div class="gallery-grid" aria-label="Galería de Jesús Rivas">
      {gallery.map((item, index) => (
        <figure class:list={['gallery-card', { featured: index === 0 }]} data-reveal>
          <img
            src={item.src}
            alt={item.alt}
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <span class="gallery-index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <strong>{item.label}</strong>
              <p>{item.copy}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="gallery-outro" data-reveal>
      <p>Más momentos, ideas y aprendizajes en Instagram.</p>
      <a class="text-link" href="https://www.instagram.com/soyjesusrivas" target="_blank" rel="noopener noreferrer">
        Ver Instagram <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .gallery { position: relative; overflow: hidden; background: var(--ink); color: var(--white); }
  .gallery::before { content: ''; position: absolute; inset: 0; opacity: .22; background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent); }
  .gallery .shell { position: relative; z-index: 1; }
  .gallery-grid { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: 210px; gap: 18px; }
  .gallery-card { position: relative; grid-column: span 4; grid-row: span 2; margin: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.16); background: var(--ink-soft); }
  .gallery-card.featured { grid-column: span 8; grid-row: span 3; }
  .gallery-card:nth-child(4), .gallery-card:nth-child(5) { grid-column: span 6; }
  .gallery-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 38%, rgba(5,8,14,.92)); transition: opacity .35s; }
  .gallery-card img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.72) contrast(1.04); transition: transform .7s cubic-bezier(.2,.7,.2,1), filter .35s; }
  .gallery-card:nth-child(2) img { object-position: center 22%; }
  .gallery-card:nth-child(4) img { object-position: center 28%; }
  .gallery-card:nth-child(5) img { object-position: center 18%; }
  .gallery-card:hover img { transform: scale(1.045); filter: saturate(1) contrast(1.02); }
  .gallery-card figcaption { position: absolute; z-index: 2; inset: auto 24px 22px; display: grid; grid-template-columns: 32px 1fr; gap: 14px; align-items: start; }
  .gallery-index { padding-top: 3px; color: var(--brass-light); font-family: var(--display); font-size: .68rem; }
  .gallery-card strong { display: block; font-family: var(--display); font-size: clamp(1.15rem, 2vw, 1.7rem); font-weight: 600; }
  .gallery-card p { max-width: 470px; margin: 5px 0 0; color: rgba(255,255,255,.64); font-size: .75rem; line-height: 1.5; }
  .gallery-outro { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin-top: 42px; padding-top: 30px; border-top: 1px solid rgba(255,255,255,.16); }
  .gallery-outro p { margin: 0; color: rgba(255,255,255,.6); }
  .gallery-outro .text-link { color: var(--brass-light); }

  @media (max-width: 900px) {
    .gallery-grid { grid-auto-rows: 190px; }
    .gallery-card, .gallery-card.featured, .gallery-card:nth-child(4), .gallery-card:nth-child(5) { grid-column: span 6; grid-row: span 2; }
    .gallery-card.featured { grid-column: span 12; grid-row: span 3; }
  }

  @media (max-width: 620px) {
    .gallery-grid { display: flex; gap: 14px; margin-inline: -16px; padding-inline: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .gallery-grid::-webkit-scrollbar { display: none; }
    .gallery-card, .gallery-card.featured, .gallery-card:nth-child(4), .gallery-card:nth-child(5) { flex: 0 0 min(84vw, 360px); height: 500px; scroll-snap-align: center; }
    .gallery-card figcaption { inset-inline: 18px; bottom: 18px; }
    .gallery-outro { align-items: flex-start; flex-direction: column; }
  }
</style>
