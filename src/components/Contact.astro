---
import SectionHeading from './SectionHeading.astro';
import { contact, whatsapp } from '../data/site';
---

<section class="contact section" id="contacto">
  <div class="shell">
    <SectionHeading eyebrow="Contacto" title="Las buenas conversaciones también transforman empresas." copy="Conferencias, mentoría, alianzas o proyectos de transformación. Cuéntame qué quieres hacer posible." light />

    <div class="contact-layout">
      <form class="contact-form" data-contact-form novalidate>
        <div class="field">
          <label for="name">Nombre</label>
          <input id="name" name="name" type="text" autocomplete="name" placeholder="Tu nombre" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="ejemplo@empresa.com" required />
        </div>
        <div class="field">
          <label for="message">Mensaje</label>
          <textarea id="message" name="message" rows="5" placeholder="¿Qué te gustaría hacer posible?" required></textarea>
        </div>
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        <button class="button" type="submit">Preparar solicitud <span aria-hidden="true">↗</span></button>
      </form>

      <aside class="contact-side" aria-label="Datos de contacto">
        <a class="button button-outline" href={whatsapp} target="_blank" rel="noopener noreferrer">Escríbeme por WhatsApp <span aria-hidden="true">↗</span></a>
        <dl>
          <div><dt>Email empresarial</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
          <div><dt>Ubicación</dt><dd>{contact.location}</dd></div>
        </dl>
        <div class="map-frame">
          <iframe title="Ubicación de la oficina de Jesús Rivas en Nápoles, Ciudad de México" src={contact.map} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </aside>
    </div>
  </div>
</section>

<dialog
  class="request-dialog"
  data-request-dialog
  aria-labelledby="request-dialog-title"
  aria-describedby="request-dialog-description"
>
  <div class="request-dialog-card">
    <button
      class="request-dialog-close"
      type="button"
      data-dialog-close
      aria-label="Cerrar mensaje"
    >
      <span aria-hidden="true">×</span>
    </button>

    <div class="request-dialog-icon" aria-hidden="true">✓</div>

    <p class="request-dialog-eyebrow">Solicitud enviada</p>

    <h2 id="request-dialog-title">
      ¡Gracias por escribirnos!
    </h2>

    <p id="request-dialog-description">
      Hemos recibido tu solicitud correctamente. Nuestro equipo la
      revisará y recibirás una respuesta en breve.
    </p>

    <button
      class="button dialog-confirm"
      type="button"
      data-dialog-close
    >
      Entendido
    </button>
  </div>
</dialog>

<script>
  const form =
    document.querySelector<HTMLFormElement>('[data-contact-form]');

  const status =
    document.querySelector<HTMLElement>('[data-form-status]');

  const dialog =
    document.querySelector<HTMLDialogElement>('[data-request-dialog]');

  const closeButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-dialog-close]');

  let shouldResetForm = false;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    shouldResetForm = true;

    if (status) {
      status.textContent = 'Solicitud enviada correctamente.';
    }

    dialog?.showModal();
  });

  closeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (dialog?.open) {
        dialog.close();
      }
    });
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });

  dialog?.addEventListener('close', () => {
    if (!shouldResetForm) {
      return;
    }

    form?.reset();

    if (status) {
      status.textContent = '';
    }

    shouldResetForm = false;
  });
</script>

<style>
  .contact-layout { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(56px, 9vw, 120px); }
  .contact-form { display: flex; flex-direction: column; gap: 22px; }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field label, .contact-side dt { color: rgba(255,253,248,.58); font-size: .66rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .field input, .field textarea { width: 100%; border: 1px solid rgba(255,255,255,.18); border-radius: 3px; padding: 15px 16px; background: var(--ink-soft); color: var(--white); outline: none; transition: border-color .2s, box-shadow .2s; }
  .field input::placeholder, .field textarea::placeholder { color: rgba(255,255,255,.32); }
  .field input:focus, .field textarea:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(47,184,166,.15); }
  .field input:user-invalid, .field textarea:user-invalid { border-color: #e2685a; }
  .form-status { min-height: 1.5em; margin: -6px 0 0; color: var(--cyan); font-size: .78rem; }
  .contact-form .button { align-self: flex-start; border: 0; }
  .contact-side { display: flex; flex-direction: column; gap: 28px; }
  .button-outline { align-self: flex-start; border-color: var(--brass); background: transparent; color: var(--brass-light); }
  .button-outline:hover { background: var(--brass); color: var(--ink); }
  .contact-side dl { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin: 0; }
  .contact-side dd { margin: 6px 0 0; }
  .contact-side dd a { color: var(--cyan); }
  .map-frame { aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid rgba(255,255,255,.16); border-radius: 4px; }
  .map-frame iframe { width: 100%; height: 100%; border: 0; }
  @media (max-width: 820px) {
    .contact-layout { grid-template-columns: 1fr; }
    .contact-side dl { grid-template-columns: 1fr; }
  }
  .request-dialog {
  width: min(560px, calc(100% - 32px));
  max-width: none;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--ink);
}

.request-dialog::backdrop {
  background: rgba(4, 8, 15, 0.82);
  backdrop-filter: blur(7px);
}

.request-dialog[open] {
  animation: request-dialog-in 0.35s
    cubic-bezier(0.2, 0.7, 0.2, 1);
}

.request-dialog-card {
  position: relative;
  overflow: hidden;
  padding: clamp(38px, 7vw, 64px);
  border: 1px solid rgba(10, 15, 26, 0.15);
  border-radius: 6px;
  background: var(--paper);
  box-shadow: 0 32px 100px rgba(0, 0, 0, 0.4);
  text-align: center;
}

.request-dialog-card::before {
  content: '';
  position: absolute;
  inset: 0 0 auto;
  height: 5px;
  background: linear-gradient(
    90deg,
    var(--brass),
    var(--cyan)
  );
}

.request-dialog-close {
  position: absolute;
  top: 18px;
  right: 18px;
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  padding: 0;
  border: 1px solid rgba(10, 15, 26, 0.18);
  border-radius: 50%;
  background: transparent;
  color: var(--ink);
  cursor: pointer;
  font-size: 1.5rem;
  line-height: 1;
  transition:
    background 0.2s,
    color 0.2s,
    transform 0.2s;
}

.request-dialog-close:hover,
.request-dialog-close:focus-visible {
  transform: rotate(8deg);
  background: var(--ink);
  color: var(--white);
}

.request-dialog-icon {
  display: grid;
  place-items: center;
  width: 68px;
  height: 68px;
  margin: 0 auto 25px;
  border-radius: 50%;
  background: var(--cyan);
  color: var(--ink);
  font-family: var(--display);
  font-size: 1.7rem;
  font-weight: 700;
}

.request-dialog-eyebrow {
  margin: 0 0 12px;
  color: var(--brass-dark);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.request-dialog h2 {
  margin: 0;
  font-family: var(--display);
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 600;
  line-height: 1.05;
  letter-spacing: -0.045em;
}

.request-dialog h2 + p {
  max-width: 420px;
  margin: 22px auto 30px;
  color: rgba(10, 15, 26, 0.68);
}

.dialog-confirm {
  border: 1px solid var(--brass);
  cursor: pointer;
}

.dialog-confirm:hover,
.dialog-confirm:focus-visible {
  border-color: var(--ink);
  color: var(--ink);
}

@keyframes request-dialog-in {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 520px) {
  .request-dialog-card {
    padding: 52px 24px 34px;
  }

  .request-dialog-close {
    top: 12px;
    right: 12px;
  }
}
</style>
