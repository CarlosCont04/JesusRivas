---
interface Props {
  name: 'facebook' | 'linkedin' | 'youtube' | 'instagram' | 'tiktok' | 'whatsapp';
}
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'facebook' && <path fill="currentColor" d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.9 3.78-3.9 1.1 0 2.24.2 2.24.2v2.46H15.2c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12Z" />}
  {name === 'linkedin' && <path fill="currentColor" d="M6.94 8.5H3.56V19h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 12.98c0-3.16-1.69-4.63-3.95-4.63-1.82 0-2.63 1-3.09 1.7V8.5h-3.38V19h3.38v-5.2c0-1.37.26-2.7 1.96-2.7 1.67 0 1.69 1.56 1.69 2.8V19h3.39v-6.02Z" />}
  {name === 'youtube' && <><rect x="2" y="5" width="20" height="14" rx="4" fill="currentColor" /><path d="m10 9 5 3-5 3V9Z" fill="var(--ink)" /></>}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17.3" cy="6.7" r="1.15" fill="currentColor" /></>}
  {name === 'tiktok' && <path fill="currentColor" d="M15 3c.25 2.1 1.42 3.4 3.5 3.8v3.05c-1.43-.04-2.63-.44-3.5-1.02v6.1a5.08 5.08 0 1 1-4.5-5.05v3.08A2.04 2.04 0 1 0 12 14.93V3h3Z" />}
  {name === 'whatsapp' && <><path fill="none" stroke="currentColor" stroke-width="1.8" d="M20.2 11.8a8.2 8.2 0 0 1-12.1 7.23L3.4 20.3l1.25-4.55A8.2 8.2 0 1 1 20.2 11.8Z" /><path fill="currentColor" d="M8.2 7.45c.18-.4.38-.4.7-.4h.47c.15 0 .34.06.43.3l.72 1.74c.08.2.04.37-.08.53l-.54.7c-.14.17-.11.34-.02.5.46.79 1.08 1.44 1.85 1.94.18.11.35.14.51-.05l.73-.9c.16-.2.34-.22.55-.14l1.72.82c.25.12.36.2.39.32.03.12.03.68-.15 1.2-.18.52-1.07 1.02-1.48 1.08-.38.06-.87.1-1.41-.07-.33-.1-.76-.25-1.31-.49-2.3-1-3.8-3.34-3.91-3.5-.11-.15-.94-1.25-.94-2.39 0-1.13.6-1.7.81-1.93Z" /></>}
</svg>

<style>
  svg { display: block; width: 21px; height: 21px; }
</style>
