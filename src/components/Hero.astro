---
import { whatsapp } from '../data/site';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-orbit orbit-one" aria-hidden="true"></div>
  <div class="hero-orbit orbit-two" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow hero-eyebrow"><span></span>Empresario · Autor · Conferencista</p>
      <h1 id="hero-title">Tecnología con <em>visión humana</em> para hacer crecer empresas.</h1>
      <p class="hero-lead">Soy Jesús Rivas. Desde 2006 construyo soluciones, equipos e ideas que ayudan a los negocios de América Latina a evolucionar con propósito.</p>
      <div class="hero-actions">
        <a class="button" href="#trayectoria">Conoce mi trayectoria <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={whatsapp} target="_blank" rel="noopener noreferrer">Iniciar una conversación <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="hero-visual" data-reveal>
      <div class="portrait-frame">
        <img src="/media/jesus-rivas-portrait.webp" alt="Jesús Rivas, empresario y cofundador de eSoft LATAM" width="1600" height="2133" fetchpriority="high" />
      </div>
      <p class="visual-note"><strong>20+</strong><span>años integrando<br />negocio y tecnología</span></p>
      <span class="vertical-label" aria-hidden="true">VISIÓN · TECNOLOGÍA · PERSONAS</span>
    </div>
  </div>
  <div class="hero-marquee" aria-hidden="true">
    <div>ESTRATEGIA <span>✦</span> INNOVACIÓN <span>✦</span> LIDERAZGO <span>✦</span> TECNOLOGÍA <span>✦</span> ESTRATEGIA <span>✦</span> INNOVACIÓN <span>✦</span></div>
  </div>
</section>
