---
import { social } from '../data/site';
import SocialIcon from './SocialIcon.astro';
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-divider" aria-hidden="true">
    <div class="shell footer-divider-inner">
      <span>Conexión</span><i></i><span>Tecnología</span><i></i><span>Propósito</span>
    </div>
  </div>
  <div class="shell footer-main">
    <div>
      <a class="brand footer-brand" href="#inicio" aria-label="Jesús Rivas — inicio"> <img class="brand-logo" src="/media/logo-light.png" alt="" width="220" height="134" /> </a>
      <p>Empresario · Autor · Conferencista</p>
    </div>
    <div class="footer-links">
      <p class="footer-label">Explorar</p>
      <a href="#trayectoria">Trayectoria</a><a href="#impacto">Impacto</a><a href="#empresas">Empresas</a><a href="#galeria">Galería</a><a href="#libros">Libros</a>
    </div>
    <div class="footer-connect">
      <p class="footer-label">Conectar</p>
      <div class="social-icons" aria-label="Redes sociales de Jesús Rivas">
        {social.map((item) => item.href ? (
          <a class="social-icon" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label} title={item.label}>
            <SocialIcon name={item.key} />
          </a>
        ) : (
          <span class="social-icon is-disabled" aria-label={`${item.label}: enlace pendiente de confirmar`} title={`${item.label} · enlace pendiente`}>
            <SocialIcon name={item.key} />
          </span>
        ))}
      </div>
      <p class="social-note">Sigue las conversaciones, ideas y nuevos proyectos.</p>
    </div>
  </div>
  <div class="shell footer-bottom">
    <p>© {year} Jesús Rivas · eSoft LATAM</p>
    <nav aria-label="Enlaces legales"><a href="/aviso-de-privacidad">Aviso de privacidad</a><a href="/terminos">Política y términos</a></nav>
  </div>
</footer>

<style>
  footer { background: #060a12; }
  .footer-brand .brand-logo { height: 48px; width: auto; }
  .footer-divider { overflow: hidden; border-block: 1px solid rgba(10,15,26,.2); background: var(--brass); color: var(--ink); }
  .footer-divider-inner { min-height: 78px; display: flex; align-items: center; justify-content: center; gap: clamp(18px, 4vw, 52px); font-family: var(--display); font-size: clamp(.68rem, 1.15vw, .88rem); font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .footer-divider i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: .5; }
  .footer-main { display: grid; grid-template-columns: 1.3fr .6fr .6fr; gap: 56px; padding-block: 70px; }
  .footer-main > div:first-child > p { margin: 18px 0 0; color: rgba(255,255,255,.5); font-size: .78rem; }
  .footer-links { display: flex; flex-direction: column; align-items: flex-start; gap: 9px; font-size: .78rem; }
  .footer-label { margin: 0 0 8px; color: var(--brass-light); font-size: .65rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .footer-links a:hover { color: var(--cyan); }
  .footer-connect { display: flex; flex-direction: column; align-items: flex-start; }
  .social-icons { display: grid; grid-template-columns: repeat(3, 46px); gap: 10px; margin-top: 9px; }
  .social-icon { display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid rgba(255,255,255,.2); border-radius: 50%; color: var(--white); transition: transform .25s, border-color .25s, background .25s, color .25s; }
  .social-icon:hover, .social-icon:focus-visible { transform: translateY(-3px); border-color: var(--brass); background: var(--brass); color: var(--ink); }
  .social-icon.is-disabled { cursor: help; opacity: .38; }
  .social-note { max-width: 230px; margin: 18px 0 0; color: rgba(255,255,255,.45); font-size: .7rem; line-height: 1.6; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 24px; padding-block: 24px; border-top: 1px solid rgba(255,255,255,.12); color: rgba(255,255,255,.45); font-size: .68rem; }
  .footer-bottom p { margin: 0; }
  .footer-bottom nav { display: flex; flex-wrap: wrap; gap: 24px; }
  @media (max-width: 680px) {
    .footer-divider-inner { min-height: 68px; gap: 13px; font-size: .58rem; letter-spacing: .1em; }
    .footer-main { grid-template-columns: 1fr 1fr; }
    .footer-main > div:first-child { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: column; }
  }
</style>
